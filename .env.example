# ============================================================================
# Caravan Concierge landing page — environment configuration
#
# Everything here is OPTIONAL. With no .env at all the app runs, the form works,
# and leads are written to .data/leads.jsonl with the notification email printed
# to the server console. Add integrations as you need them.
#
# Copy to .env.local for development, or set these in your host's dashboard.
# ============================================================================

# --- Site -------------------------------------------------------------------

# The public URL this page is served from. Used for canonical URLs, JSON-LD,
# sitemap and llms.txt.
NEXT_PUBLIC_SITE_URL=https://offer.caravanconcierge.com.au

# Shown in the availability strip: "Spaces available as of {date}".
# Keep this current — a stale date is worse than no date.
NEXT_PUBLIC_AVAILABILITY_DATE=2026-08-16


# --- Lead delivery: local store (always on) ---------------------------------

# Where leads are appended as JSONL. On a serverless host, point this at a
# mounted volume, or rely on the webhook/Sheets sinks for durability.
# LEADS_FILE=.data/leads.jsonl


# --- Lead delivery: email ---------------------------------------------------
# Without these, the notification email is rendered to the server console.

# RESEND_API_KEY=re_xxxxxxxxxxxx
# LEAD_EMAIL_TO=kassandra@caravanconcierge.com.au,info@caravanconcierge.com.au
# LEAD_EMAIL_FROM=leads@caravanconcierge.com.au


# --- Lead delivery: SMS (Twilio) --------------------------------------------
# The highest-leverage integration here. Speed-to-lead is the single best
# predictor of close rate for local services — a text gets read now, an email
# gets read whenever.

# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM=+61400000000
# LEAD_SMS_TO=+61400000000,+61411111111


# --- Lead delivery: webhook (Zapier / Make / CRM) ---------------------------

# LEAD_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/000000/xxxxxx
# Optional: signs the payload with HMAC-SHA256 so the receiver can verify it.
# LEAD_WEBHOOK_SECRET=a-long-random-string


# --- Lead delivery: Google Sheets -------------------------------------------
# Create a service account, download its JSON key, then share the target sheet
# with the service account's email address as an Editor.

# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n..."}
# GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz
# GOOGLE_SHEET_RANGE=Leads!A:P


# --- Analytics --------------------------------------------------------------
# Both are optional and consent-gated. First-party funnel events flow to
# /api/events regardless, so per-step drop-off data works without either of
# these and without cookie consent.

# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_META_PIXEL_ID=000000000000000


# --- Security ---------------------------------------------------------------

# Salt for hashing visitor IPs before they are stored. Set this in production;
# without it the hash is predictable.
# IP_SALT=change-me-to-something-random

# Cloudflare Turnstile. Left unset, the invisible bot heuristics (honeypot +
# timing + user agent) are used alone — which is usually enough, and costs
# genuine customers nothing.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x0000000000000000
# TURNSTILE_SECRET_KEY=0x0000000000000000


# --- Monitoring -------------------------------------------------------------

# TELEMETRY_FILE=.data/telemetry.jsonl
# Set to false to keep Web Vitals and funnel events in memory only.
# TELEMETRY_PERSIST=true
